generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Escola {
  id       Int          @id @default(autoincrement())
  nome     String
  endereco String?
  telefone String?
  bebes    Bebe[]
  adis     Adi[]
  avisos   AvisoGeral[]
  turmas   Turma[]
  eventos  Evento[]
}

model Turma {
  id        Int             @id @default(autoincrement())
  nome      String
  anoLetivo Int
  escolaId  Int
  bebes     Bebe[]
  escola    Escola          @relation(fields: [escolaId], references: [id])
  vivencias VivenciaGeral[]
  adis      Adi[]           @relation("ADITurma")
  eventos   Evento[]
}

model Bebe {
  id               Int                @id @default(autoincrement())
  nome             String
  dataNascimento   DateTime?
  genero           String?
  alergias         String?
  medicamentos     String?
  observacoesSaude String?
  autorizadosBusca String?
  fotoUrl          String?
  escolaId         Int
  escola           Escola             @relation(fields: [escolaId], references: [id])
  turmaId          Int
  turma            Turma              @relation(fields: [turmaId], references: [id])
  diarios          DiarioIndividual[]
  ocorrencias      Ocorrencia[]
  responsaveis     VinculoFamiliar[]
}

model Responsavel {
  id        Int               @id @default(autoincrement())
  nome      String
  cpf       String            @unique
  telefone  String?
  email     String            @unique
  senhaHash String
  endereco  String?

  // Mudança aqui: O responsável se relaciona com a tabela de vínculo
  bebes     VinculoFamiliar[]
}

// A NOVA TABELA PIVÔ EXPLICÍTICA
model VinculoFamiliar {
  id            Int         @id @default(autoincrement())
  bebeId        Int
  bebe          Bebe        @relation(fields: [bebeId], references: [id])
  responsavelId Int
  responsavel   Responsavel @relation(fields: [responsavelId], references: [id])

  parentesco    String

  @@unique([bebeId, responsavelId])
  @@map("vinculo_familiar")
}

model Adi {
  id          Int                @id @default(autoincrement())
  nome        String
  matricula   String             @unique
  email       String             @unique
  telefone    String?
  senhaHash   String
  escolaId    Int
  escola      Escola             @relation(fields: [escolaId], references: [id])
  diarios     DiarioIndividual[]
  ocorrencias Ocorrencia[]
  vivencias   VivenciaGeral[]
  turmas      Turma[]            @relation("ADITurma")
  @@map("ADI")
}

model DiarioIndividual {
  id                        Int       @id @default(autoincrement())
  data                      DateTime  @default(now())
  frequencia                Boolean   @default(true)
  chegadaHumor              String?
  alimentacao               String?
  banho                     Boolean   @default(false)
  sono                      String?
  desenvolvimentoPedagogico String?
  observacoesFinais         String?
  atividades                String?
  fralda                    String?
  enviadoEm                 DateTime?
  bebeId                    Int
  adiId                     Int
  adi                       Adi       @relation(fields: [adiId], references: [id])
  bebe                      Bebe      @relation(fields: [bebeId], references: [id])
}

model Ocorrencia {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String
  dia        DateTime  @default(now())
  horario    DateTime @default(now())
  prioridade String   @default("BAIXA")
  bebeId     Int
  adiId      Int
  adi        Adi      @relation(fields: [adiId], references: [id])
  bebe       Bebe     @relation(fields: [bebeId], references: [id])
}

model VivenciaGeral {
  id        Int      @id @default(autoincrement())
  data      DateTime @default(now())
  titulo    String
  descricao String
  fotosJson Json?
  turmaId   Int
  adiId     Int
  adi       Adi      @relation(fields: [adiId], references: [id])
  turma     Turma    @relation(fields: [turmaId], references: [id])
}

model AvisoGeral {
  id            Int       @id @default(autoincrement())
  titulo        String
  conteudo      String
  dataCriacao   DateTime  @default(now())
  dataExpiracao DateTime?
  escolaId      Int
  escola        Escola    @relation(fields: [escolaId], references: [id])
}

model Evento {
  id             Int       @id @default(autoincrement())
  titulo         String
  descricao      String
  local          String
  dataEvento     DateTime?
  horario_inicio DateTime  @default(now())
  horario_fim    DateTime  @default(now())
  dataCriacao    DateTime  @default(now())

  escolaId      Int
  escola        Escola    @relation(fields: [escolaId], references: [id])

  turmaId       Int
  turma         Turma    @relation(fields: [turmaId], references: [id])
}
